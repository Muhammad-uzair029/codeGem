# electron-builder + pnpm on Windows: the NSIS installer generator reads
# `!include` templates from app-builder-lib/templates/nsis/include/*.nsh.
# pnpm's default symlink layout nests those files under
# node_modules/.pnpm/app-builder-lib@25.1.8_dmg-builder@25.1.8_.../node_modules/…
# which blows past Windows' MAX_PATH (260 chars). Force a flat layout so
# NSIS include paths stay short.
node-linker=hoisted
shamefully-hoist=true

# Keep the store outside the workspace so hoisted node_modules stays lean.
strict-peer-dependencies=false
auto-install-peers=true
