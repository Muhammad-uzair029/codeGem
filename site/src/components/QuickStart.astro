---
// Three steps for a newcomer, next to a terminal that plays them out.
// The active step lights up while its lines type. Clicking a step shows that
// part of the run. Without JavaScript or with reduced motion, every line is
// shown at once and the steps are plain text.
import { getManifest } from '../../lib/skills.mjs';
const m = getManifest();
const loop = m.skills.find((s) => s.name === 'feature-loop');
const count = loop ? loop.allDeps.length + 1 : 1;
const steps = [
  {
    title: 'Install',
    body: 'Paste one command in your project folder. Skills land in <code>.claude/skills/</code> and nothing else changes.',
  },
  {
    title: 'Open Claude Code',
    body: 'Run <code>claude</code> in the same folder. No Claude Code yet? <a href="/getting-started/">Getting started</a> shows how.',
  },
  {
    title: 'Type / and the skill name',
    body: 'For example <code>/feature-loop</code> or <code>/pre-merge-check</code>. Claude reads the skill and follows it.',
  },
];
const lines = [
  { step: 0, kind: 'cmd', text: 'cd my-app' },
  { step: 0, kind: 'cmd', text: `curl -fsSL ${m.siteUrl}/install.sh | bash -s -- feature-loop`, install: true },
  { step: 0, kind: 'out', text: 'codeGem skills -> ~/my-app/.claude/skills' },
  { step: 0, kind: 'ok', text: `Installed (${count}): feature-loop, system-design, pre-merge-check, ...` },
  { step: 1, kind: 'cmd', text: 'claude' },
  { step: 1, kind: 'out', text: 'Claude Code ready in ~/my-app' },
  { step: 2, kind: 'prompt', text: '/feature-loop auth/login' },
  { step: 2, kind: 'out', text: 'Stage 0: brainstorming against your existing specs ...' },
];
---
<div class="qs" data-qs>
  <ol class="qs-steps">
    {steps.map((s, i) => (
      <li>
        <button type="button" class="qs-step" data-qs-step={i} aria-pressed="false">
          <span class="qs-num" aria-hidden="true">{i + 1}</span>
          <span class="qs-text">
            <span class="qs-title">{s.title}</span>
            <span class="qs-body" set:html={s.body} />
          </span>
        </button>
      </li>
    ))}
  </ol>
  <div class="term" aria-label="Example: installing and running the feature-loop">
    <div class="term-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <em>~/my-app</em>
      <button type="button" class="term-replay" data-qs-replay hidden>Replay</button>
    </div>
    <div class="term-body" data-qs-body>{lines.map((l) => (
      <span class={`tl tl-${l.kind}`} data-kind={l.kind} data-step={l.step} data-term-install={l.install ? '' : undefined}>{l.text}</span>
    ))}<span class="caret" aria-hidden="true"></span></div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-qs]').forEach((root) => {
    const body = root.querySelector<HTMLElement>('[data-qs-body]')!;
    const spans = Array.from(body.querySelectorAll<HTMLElement>('.tl'));
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-qs-step]'));
    const replay = root.querySelector<HTMLButtonElement>('[data-qs-replay]')!;
    spans.forEach((s) => {
      if (s.hasAttribute('data-term-install')) s.textContent = `curl -fsSL ${location.origin}/install.sh | bash -s -- feature-loop`;
    });
    const texts = spans.map((s) => s.textContent || '');
    const motion = document.documentElement.classList.contains('motion');
    let run = 0; // bumps to cancel a running animation

    const setStep = (k: number) => {
      root.dataset.step = String(k);
      steps.forEach((b, i) => {
        b.setAttribute('aria-pressed', String(i === k));
        b.classList.toggle('done', i < k);
      });
      spans.forEach((s) => s.classList.toggle('dim', k >= 0 && Number(s.dataset.step) !== k));
    };

    const showUpTo = (k: number) => {
      run++;
      spans.forEach((s, i) => {
        const on = Number(s.dataset.step) <= k;
        s.hidden = !on;
        s.textContent = texts[i];
      });
      setStep(k);
      replay.hidden = !motion;
    };

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const play = async () => {
      const id = ++run;
      replay.hidden = true;
      spans.forEach((s) => {
        s.textContent = '';
        s.hidden = true;
        s.classList.remove('dim');
      });
      for (let i = 0; i < spans.length; i++) {
        const s = spans[i];
        const k = Number(s.dataset.step);
        if (root.dataset.step !== String(k)) setStep(k);
        spans.forEach((x) => x.classList.remove('dim'));
        s.hidden = false;
        if (s.dataset.kind === 'cmd' || s.dataset.kind === 'prompt') {
          await sleep(i === 0 ? 350 : 520);
          const t = texts[i];
          const stride = t.length > 40 ? 3 : 1;
          for (let c = 0; c <= t.length; c += stride) {
            if (id !== run) return;
            s.textContent = t.slice(0, c);
            await sleep(30);
          }
          s.textContent = t;
        } else {
          await sleep(s.dataset.kind === 'ok' ? 420 : 260);
          if (id !== run) return;
          s.textContent = texts[i];
        }
        if (id !== run) return;
      }
      steps.forEach((b) => b.classList.add('done'));
      replay.hidden = false;
    };

    steps.forEach((b, i) => b.addEventListener('click', () => showUpTo(i)));
    replay.addEventListener('click', () => play());

    if (!motion) {
      showUpTo(2);
      setStep(-1);
      spans.forEach((s) => s.classList.remove('dim'));
      return;
    }
    spans.forEach((s) => (s.hidden = true));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          play();
        }
      }, { threshold: 0.35 });
      io.observe(root);
    } else play();
  });
</script>
