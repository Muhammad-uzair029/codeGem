---
// Terminal-style block that types out the install command and a short run.
// Without JavaScript, or with reduced motion, the final text is shown as is.
import { getManifest } from '../../lib/skills.mjs';
const m = getManifest();
const loop = m.skills.find((s) => s.name === 'feature-loop');
const count = loop ? loop.allDeps.length + 1 : 1;
const lines = [
  { kind: 'cmd', text: 'cd my-app' },
  { kind: 'cmd', text: `curl -fsSL ${m.siteUrl}/install.sh | bash -s -- feature-loop`, install: true },
  { kind: 'out', text: 'Downloading feature-loop ...' },
  { kind: 'out', text: `codeGem skills -> ~/my-app/.claude/skills` },
  { kind: 'ok', text: `  Installed (${count}): feature-loop, system-design, pre-merge-check, ...` },
  { kind: 'cmd', text: 'claude' },
  { kind: 'prompt', text: '/feature-loop -y auth/login' },
  { kind: 'out', text: '[stage 0] brainstorming against existing specs ...' },
];
---
<div class="term" data-term aria-label="Example: installing and running the feature-loop">
  <div class="term-bar" aria-hidden="true"><span></span><span></span><span></span><em>Terminal</em></div>
  <div class="term-body" data-term-body>{lines.map((l) => (
    <span class={`tl tl-${l.kind}`} data-kind={l.kind} data-term-install={l.install ? '' : undefined}>{l.text}</span>
  ))}<span class="caret" aria-hidden="true"></span></div>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-term]').forEach((term) => {
    const body = term.querySelector<HTMLElement>('[data-term-body]');
    if (!body) return;
    const spans = Array.from(body.querySelectorAll<HTMLElement>('.tl'));
    // Always show this site's real origin.
    spans.forEach((s) => {
      if (s.hasAttribute('data-term-install')) s.textContent = `curl -fsSL ${location.origin}/install.sh | bash -s -- feature-loop`;
    });
    if (reduce) return;
    const texts = spans.map((s) => s.textContent || '');
    spans.forEach((s) => {
      s.textContent = '';
      s.hidden = true;
    });
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let started = false;
    const run = async () => {
      if (started) return;
      started = true;
      for (let i = 0; i < spans.length; i++) {
        const s = spans[i];
        const kind = s.dataset.kind;
        s.hidden = false;
        if (kind === 'cmd' || kind === 'prompt') {
          await sleep(i === 0 ? 300 : 450);
          const t = texts[i];
          const step = t.length > 40 ? 2 : 1;
          for (let c = 0; c <= t.length; c += step) {
            s.textContent = t.slice(0, c);
            await sleep(28);
          }
          s.textContent = t;
        } else {
          await sleep(kind === 'ok' ? 380 : 220);
          s.textContent = texts[i];
        }
      }
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          run();
        }
      });
      io.observe(term);
    } else run();
  });
</script>
