---
import '../styles/global.css';
import '../styles/motion.css';
import { getManifest } from '../../lib/skills.mjs';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'browse' | 'start';
}
const { title, description = 'Browse, learn, and install codeGem skills for Claude Code with one command.', active } = Astro.props;
const manifest = getManifest();
const fullTitle = title === 'codeGem Skills' ? title : `${title} · codeGem Skills`;
---
<!doctype html>
<html lang="en" data-os="unix">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f7b6c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Before paint: theme and preferred OS tab (per-viewer convenience only).
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('cg-theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
        var os = /Windows/i.test(navigator.userAgent) ? 'windows' : 'unix';
        try {
          var o = localStorage.getItem('cg-os');
          if (o === 'unix' || o === 'windows') os = o;
        } catch (e) {}
        d.dataset.os = os;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      })();
    </script>
  </head>
  <body data-site-url={manifest.siteUrl}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M9 4h14l6 8-13 16L3 12z" fill="var(--accent)" />
            <path d="M3 12h26M9 4l7 24M23 4l-7 24M9 4l3 8M23 4l-3 8" stroke="var(--bg)" stroke-width="1.4" fill="none" stroke-linejoin="round" />
          </svg>
          codeGem <small>Skills</small>
        </a>
        <nav class="nav" aria-label="Main">
          <a class="nav-cta" href="/#download"><span class="long">Download app</span><span class="short">App</span></a>
          <a href="/browse/" aria-current={active === 'browse' ? 'page' : undefined}>Browse</a>
          <a href="/getting-started/" aria-current={active === 'start' ? 'page' : undefined}><span class="long">Getting started</span><span class="short">Start</span></a>
          <button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>{manifest.skillCount} skills · built from <code>.claude/skills/</code> on {manifest.generatedAt.slice(0, 10)}</span>
        <span><a href="/manifest.json">manifest.json</a> · <a href="/install.sh">install.sh</a> · <a href="/install.ps1">install.ps1</a></span>
      </div>
    </footer>
    <script>
      import { initSite } from '../scripts/site.js';
      initSite();
    </script>
  </body>
</html>
