---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '../styles/global.css';
import '../styles/motion.css';
import { getManifest } from '../../lib/skills.mjs';

interface Props {
  title: string;
  description?: string;
  active?: Section;
}
type Section = 'home' | 'skills' | 'browse' | 'learn' | 'interview' | 'courses' | 'start' | 'download';
const TAGLINE = 'Skills, learning and interview prep for AI engineers';
// The one place the main navigation is defined. `key` matches the page's `active` prop.
const NAV: { key: Section; href: string; label: string; cta?: boolean }[] = [
  { key: 'skills', href: '/skill/', label: 'Skills' },
  { key: 'learn', href: '/learn/', label: 'Learn' },
  { key: 'interview', href: '/interview/', label: 'Interview prep' },
  { key: 'courses', href: '/courses/', label: 'Courses' },
  { key: 'start', href: '/getting-started/', label: 'Getting started' },
  { key: 'download', href: '/#download', label: 'Download app', cta: true },
];
const {
  title,
  description = 'codeGem: Claude Code skills you install with one command, interactive AI-engineering lessons, and interview practice.',
  active,
} = Astro.props;
const current = active === 'browse' ? 'skills' : active;
const manifest = getManifest();
const fullTitle = title === 'codeGem' ? `codeGem: ${TAGLINE}` : `${title} | codeGem`;
---
<!doctype html>
<html lang="en" data-os="unix">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f5f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f1d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Before paint: theme and preferred OS tab (per-viewer convenience only).
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('cg-theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
        var os = /Windows/i.test(navigator.userAgent) ? 'windows' : 'unix';
        try {
          var o = localStorage.getItem('cg-os');
          if (o === 'unix' || o === 'windows') os = o;
        } catch (e) {}
        d.dataset.os = os;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      })();
    </script>
  </head>
  <body data-site-url={manifest.siteUrl}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="codeGem home">
          <svg class="brand-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M3 12 9.5 4h13L29 12 16 29z" fill="var(--accent)" />
            <path d="M3 12h26L16 29zM9.5 4 13 12l3-8 3 8 3.5-8" fill="none" stroke="var(--brand-line)" stroke-width="1.3" stroke-linejoin="round" />
            <path d="M3 12h10l3 17z" fill="#fff" fill-opacity="0.18" />
          </svg>
          codeGem
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          {NAV.map((n) => (
            <a href={n.href} class={n.cta ? 'nav-cta' : undefined} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <a class="nav-search" href="/browse/#q" aria-label="Search skills (press / or Ctrl+K)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <kbd data-kbd-hint>/</kbd>
          </a>
          <button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <button class="icon-btn menu-btn" type="button" id="menu-toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path class="mb-top" d="M4 7h16" /><path class="mb-mid" d="M4 12h16" /><path class="mb-bot" d="M4 17h16" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span class="foot-brand"><strong>codeGem</strong>. {TAGLINE}. {manifest.skillCount} skills, updated {manifest.generatedAt.slice(0, 10)}.</span>
        <nav class="foot-links" aria-label="Footer">
          <a href="/skill/">Skills</a><a href="/learn/">Learn</a><a href="/interview/">Interview prep</a><a href="/courses/">Courses</a><a href="/getting-started/">Getting started</a><a href="/#download">Desktop app</a>
        </nav>
        <nav class="foot-links foot-raw" aria-label="Raw files"><a href="/manifest.json">manifest.json</a><a href="/install.sh">install.sh</a><a href="/install.ps1">install.ps1</a></nav>
      </div>
    </footer>
    <script>
      import { initSite } from '../scripts/site.js';
      initSite();
    </script>
  </body>
</html>
