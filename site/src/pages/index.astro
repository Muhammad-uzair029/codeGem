---
import Base from '../layouts/Base.astro';
import InstallCommand from '../components/InstallCommand.astro';
import HeroGem from '../components/HeroGem.astro';
import DownloadApp from '../components/DownloadApp.astro';
import { getManifest } from '../../lib/skills.mjs';

const m = getManifest();
---
<Base title="codeGem" active="home">
  <section class="hero hero-hub">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker" data-anim style="--d:0">
          <span class="dot" aria-hidden="true"></span>Free, for AI engineers
        </p>
        <h1 data-anim style="--d:1">Build with AI. Learn how it works. Ace the interview.</h1>
        <p class="lede" data-anim style="--d:2">
          codeGem is one hub with three parts: Claude Code skills you install with one command,
          10 short AI-engineering lessons, and interview practice.
        </p>
        <div class="actions" data-anim style="--d:3">
          <a class="btn" href="/skill/">Get the skills</a>
          <a class="btn secondary" href="/learn/">Start learning</a>
          <a class="btn secondary" href="/interview/">Practise interviews</a>
        </div>
      </div>
      <div class="hero-art" data-anim style="--d:2">
        <HeroGem />
      </div>
    </div>
  </section>

  <section class="wrap section hub-pillars" aria-labelledby="pillars-h">
    <h2 id="pillars-h" class="sr-only">What is on codeGem</h2>
      <ul class="pillars">
        <li>
          <a class="pillar" data-p="skills" href="/skill/">
            <svg class="pillar-art" viewBox="0 0 240 110" aria-hidden="true">
              <rect class="pa-panel" x="16" y="14" width="208" height="82" rx="10" />
              <circle class="pa-dim" cx="32" cy="28" r="3.5" /><circle class="pa-dim" cx="44" cy="28" r="3.5" /><circle class="pa-dim" cx="56" cy="28" r="3.5" />
              <text class="pa-code" x="30" y="59"><tspan class="pa-acc">&gt;</tspan> /feature-loop</text>
              <rect class="pa-acc-fill pa-blink" x="172" y="47" width="8" height="14" rx="1" />
              <path class="pa-gem" d="M186 80 l7 -9 h14 l7 9 -14 16z" />
              <path class="pa-gem-line" d="M186 80 h28 M193 71 l4 9 3 -9 3 9 4 -9 M197 80 l3 16 3 -16" />
            </svg>
            <span class="pillar-meta">{m.skillCount} skills</span>
            <h3>Skills</h3>
            <p>Ready-made instructions for Claude Code that plan features, check code before merge, and handle git chores. One command installs them.</p>
            <span class="pillar-go">Explore skills</span>
          </a>
        </li>
        <li>
          <a class="pillar" data-p="learn" href="/learn/">
            <svg class="pillar-art" viewBox="0 0 240 110" aria-hidden="true">
              <path class="pa-wire" d="M52 55 H100 M140 55 H188 M120 35 V20 H188 V40" />
              <path class="pa-wire pa-flow" d="M52 55 H100 M140 55 H188" />
              <rect class="pa-node" x="16" y="40" width="36" height="30" rx="7" />
              <rect class="pa-node pa-node-acc" x="100" y="35" width="40" height="40" rx="9" />
              <rect class="pa-node" x="188" y="40" width="36" height="30" rx="7" />
              <text class="pa-label" x="34" y="59" text-anchor="middle">Q</text>
              <text class="pa-label pa-label-acc" x="120" y="60" text-anchor="middle">RAG</text>
              <text class="pa-label" x="206" y="59" text-anchor="middle">A</text>
              <rect class="pa-track" x="16" y="90" width="208" height="6" rx="3" />
              <rect class="pa-fill" x="16" y="90" width="124" height="6" rx="3" />
            </svg>
            <span class="pillar-meta">10 modules</span>
            <h3>Learn</h3>
            <p>From LLM basics to RAG, agents, evals and AI system design. Short lessons with diagrams; your progress is saved in your browser.</p>
            <span class="pillar-go">Start learning</span>
          </a>
        </li>
        <li>
          <a class="pillar" data-p="interview" href="/interview/">
            <svg class="pillar-art" viewBox="0 0 240 110" aria-hidden="true">
              <rect class="pa-panel" x="16" y="16" width="132" height="34" rx="10" />
              <rect class="pa-line" x="28" y="29" width="90" height="8" rx="4" />
              <rect class="pa-opt" x="40" y="60" width="108" height="16" rx="6" />
              <rect class="pa-opt pa-opt-ok" x="40" y="82" width="108" height="16" rx="6" />
              <path class="pa-tick" d="M126 90 l4 4 8 -8" />
              <circle class="pa-ring-bg" cx="192" cy="58" r="28" />
              <circle class="pa-ring" cx="192" cy="58" r="28" pathLength="100" />
              <text class="pa-label" x="192" y="63" text-anchor="middle">12:00</text>
            </svg>
            <span class="pillar-meta">Practice and mock interviews</span>
            <h3>Interview prep</h3>
            <p>Questions for every topic, with model answers. When you feel ready, try a timed mock interview.</p>
            <span class="pillar-go">Start practising</span>
          </a>
        </li>
      </ul>
      <a class="courses-strip" href="/courses/">
        <span class="courses-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5 12 3l9 3.5-9 3.5z" /><path d="M7 8.3V13c0 1.7 2.2 3 5 3s5-1.3 5-3V8.3" /><path d="M21 6.5V12" /></svg>
        </span>
        <span class="courses-text"><strong>Courses</strong> A checked list of AI courses worth your time, starting with Anthropic's own.</span>
        <span class="pillar-go">See courses</span>
      </a>
      <a class="courses-strip new-strip" href="/skill/feature-qa/">
        <span class="courses-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6" /><path d="M10 3v6.5L5 18a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-8.5V3" /><path d="M7.5 14h9" /></svg>
        </span>
        <span class="courses-text"><span class="new-tag">New</span><strong>feature-qa</strong> Tests any feature end to end with Playwright, no human needed, and hands you a report.</span>
        <span class="pillar-go">See the skill</span>
      </a>
  </section>

  <section class="wrap section" aria-labelledby="start-h">
    <header class="section-head" data-reveal>
      <h2 id="start-h">Get started in 3 steps</h2>
      <p class="section-lead">New to all this? The <a href="/getting-started/">Getting started guide</a> walks through each part slowly.</p>
    </header>
    <ol class="hub-steps" data-reveal>
      <li class="hub-step hub-step-wide">
        <span class="hub-num" aria-hidden="true">1</span>
        <div class="hub-step-body">
          <h3>Install the skills</h3>
          <p class="muted">Run this in your project folder. It adds all {m.skillCount} skills to <code>.claude/skills/</code> and changes nothing else.</p>
          <InstallCommand args={['--all']} label={`Install all ${m.skillCount} skills`} />
          <p class="faint">Want only some, or the details first? <a href="/skill/">See the Skills page</a>. Already installed? <a href="/skill/#update">Update to the latest</a>.</p>
        </div>
      </li>
      <li class="hub-step">
        <span class="hub-num" aria-hidden="true">2</span>
        <div class="hub-step-body">
          <h3>Use one in Claude Code</h3>
          <p class="muted">Run <code>claude</code> in the same folder, then type <code>/</code> and a skill name, for example <code>/feature-loop</code>.</p>
          <p class="faint">No Claude Code yet? <a href="/getting-started/#skills">Set it up here</a>.</p>
        </div>
      </li>
      <li class="hub-step">
        <span class="hub-num" aria-hidden="true">3</span>
        <div class="hub-step-body">
          <h3>Learn, then practise</h3>
          <p class="muted">Work through the <a href="/learn/">Learn modules</a> at your own pace, then test yourself in <a href="/interview/">Interview prep</a>.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="wrap section" id="download" aria-labelledby="dl-h">
    <header class="section-head" data-reveal>
      <h2 id="dl-h">Get the codeGem desktop app</h2>
      <p class="section-lead">Optional. It runs the feature-loop skill in a window instead of the terminal, and installs the skills for you.</p>
    </header>
    <div data-reveal><DownloadApp /></div>
  </section>
</Base>
