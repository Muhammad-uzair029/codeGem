---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist. Head back to SkillFacet's skills, lessons and interview prep.">
  <main class="wrap section" style="text-align:center;max-width:40rem">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist</h1>
    <p class="muted">The link may be old or mistyped. Here's where most people want to go:</p>
    <p style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px">
      <a class="btn" href="/">Home</a>
      <a class="btn secondary" href="/skill/">Skills</a>
      <a class="btn secondary" href="/learn/">Learn</a>
      <a class="btn secondary" href="/interview/">Interview prep</a>
    </p>
  </main>
</Base>
