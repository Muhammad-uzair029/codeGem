{
  "name": "feature-loop-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone orchestrator workspace that clones, boots, and updates client repositories for the claude-code-boilerplate feature-loop engine.",
  "author": {
    "name": "Softaims",
    "email": "engineering@softaims.com"
  },
  "homepage": "https://github.com/Softaims/claude-code-boilerplate",
  "repository": {
    "type": "git",
    "url": "https://github.com/Softaims/claude-code-boilerplate.git",
    "directory": "apps/feature-loop-manager"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "clean": "rm -rf out dist",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "pack:mac": "electron-vite build && electron-builder --mac",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:linux": "electron-vite build && electron-builder --linux",
    "release": "electron-vite build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.19",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.40",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "com.softaims.feature-loop-manager",
    "productName": "Feature-Loop Manager",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "asar": true,
    "files": [
      "out/**/*",
      "templates/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/tsconfig*.json"
    ],
    "extraResources": [
      {
        "from": "../../.claude/skills",
        "to": "boilerplate/.claude/skills",
        "filter": ["**/*"]
      },
      {
        "from": "../../CLAUDE.md",
        "to": "boilerplate/CLAUDE.md"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "Softaims",
      "repo": "claude-code-boilerplate",
      "releaseType": "release"
    }
  }
}
